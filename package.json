{
  "name": "severino-obsidian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin suite for the Severino Labs vault: site-accurate writeup preview plus authoring power-ups, built on the site's own renderer.",
  "scripts": {
    "build": "npm run version:sync && node esbuild.config.ts",
    "dev": "node esbuild.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-obsidian-stub.ts --test 'tests/*.test.ts'",
    "version:sync": "node scripts/sync-version.ts",
    "version:check": "node scripts/sync-version.ts --check",
    "preview:render": "node scripts/preview-render.ts",
    "commands:emit": "node bin/emit-obsidian-commands.ts",
    "commands:check": "node bin/emit-obsidian-commands.ts --check",
    "describe": "node bin/severino-obsidian --describe",
    "describe:write": "node bin/severino-obsidian --write"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "cordon-spec": "2.1.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "npm@11.19.0"
}
